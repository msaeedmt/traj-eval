{
  "description": "One header record per trial, written before the event stream.",
  "properties": {
    "trial_id": {
      "title": "Trial Id",
      "type": "string"
    },
    "schema_version": {
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "testbed": {
      "description": "'lean' or 'astro'",
      "title": "Testbed",
      "type": "string"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
