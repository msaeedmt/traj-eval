# Public template for an OpenAI-compatible Qwen endpoint.
# Copy to configs/qwen.remote.local.env and fill in your endpoint plus key.
# The local file must stay untracked.

OPENAI_BASE_URL=https://your-qwen-endpoint.example/v1
OPENAI_API_BASE=https://your-qwen-endpoint.example/v1
OPENAI_API_KEY=

# Optional. Leave blank to auto-detect the first model from /models.
CMBAGENT_EVAL_LOCAL_MODEL=
