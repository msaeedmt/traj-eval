# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# uv / venv
.venv/
uv.lock.bak

# Lean / Mathlib build artifacts
*.olean
/lake-packages/
/.lake/
/dataset/Lean/.traj_eval_tmp/
build/

# Trial logs & datasets are large / regenerable: track structure, not contents
/data/**
!/data/.gitkeep
!/data/batch/
!/data/batch/version_4_routing_ablation/
!/data/batch/version_4_routing_ablation/**
/runs/
*.jsonl
!/data/batch/version_4_routing_ablation/**/*.jsonl
!/data/analysis/
!/data/analysis/lean_easy_failure_reviews.jsonl
!/data/analysis/presentations/
!/data/analysis/presentations/**

# Secrets — never commit API keys
.env
*.key
/configs/*.env
!/configs/*.example.env

# Local scratch and transient desktop files
/outputs/
~$*
*:Zone.Identifier
*.Zone.Identifier
Zone.Identifier

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp
