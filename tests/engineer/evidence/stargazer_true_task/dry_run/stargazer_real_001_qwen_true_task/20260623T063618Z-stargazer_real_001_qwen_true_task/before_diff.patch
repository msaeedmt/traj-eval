- {"tool": "write_file", "path": "tests/engineer/evidence/stargazer_codex_orchestration/engineer_work/stargazer_engineer_script.py", "content": "from __future__ import annotations\n\nimport json\nimport math\nfrom pathlib import Path\nfrom statistics import fmean, pstdev\n\nOBS_PATH = Path(\"notebooks/qwen_saeed_stargazer_real1/tasks/stargazer_real_real_001_minimal/stargazer_observations.json\")\nOUT_PATH = Path(\"tests/engineer/evidence/stargazer_codex_orchestration/engineer_work/agent_submission.json\")\n\n\ndef main() -> None:\n    data = json.loads(OBS_PATH.read_text(encoding=\"utf-8\"))\n    obs = data[\"observations\"]\n    times = [float(x) for x in obs[\"times_days\"]]\n    rvs = [float(x) for x in obs[\"rvs_ms\"]]\n\n    baseline = max(times) - min(times)\n    period = max(1.0, baseline / 4.0)\n    amplitude = (max(rvs) - min(rvs)) / 2.0\n    jitter = max(1.0, pstdev(rvs) if len(rvs) > 1 else 1.0)\n    mass = max(0.001, amplitude / (28.4329 * period ** (-1.0 / 3.0)))\n\n    submission = {\n        \"planets\": [\n            {\n                \"P_days\": period,\n                \"m_sin_i_mjup\": mass,\n                \"e\": 0.0,\n                \"inc_rad\": math.pi / 2.0,\n                \"Omega_rad\": 0.0,\n                \"omega_rad\": 0.0,\n                \"l_rad\": 0.0,\n            }\n        ],\n        \"noise\": {\"sigma_jitter_ms\": jitter},\n        \"metadata\": {\n            \"source\": \"engineer_placeholder_test\",\n            \"task_id\": \"removed_legacy_placeholder\",\n            \"rv_mean_ms\": fmean(rvs),\n        },\n    }\n\n    OUT_PATH.parent.mkdir(parents=True, exist_ok=True)\n    OUT_PATH.write_text(json.dumps(submission, indent=2), encoding=\"utf-8\")\n    print(f\"wrote {OUT_PATH}\")\n    print(f\"period_days={period:.6f}\")\n    print(f\"m_sin_i_mjup={mass:.6f}\")\n\n\nif __name__ == \"__main__\":\n    main()\n"}
